{
  "name": "dsh-webnovel-writer",
  "version": "0.1.0",
  "description": "Adds Chinese web-fiction planning, file-backed memory, chapter workflow, consistency review, and style profiling skills to DeepSeek Harness agents.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/index.test.js",
    "check": "node --check lib/index.js && node test/index.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "webnovel",
    "writing",
    "chinese-fiction",
    "skill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RrcoVer0/dsh-webnovel-writer.git"
  },
  "homepage": "https://github.com/RrcoVer0/dsh-webnovel-writer#readme",
  "bugs": {
    "url": "https://github.com/RrcoVer0/dsh-webnovel-writer/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.6-alpha.2 <0.2.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-skill": ">=0.1.6-alpha.2 <0.2.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.6-alpha.2 <0.2.0-0"
